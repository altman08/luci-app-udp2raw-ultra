#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/udp2raw
MONITOR=/usr/share/udp2raw-ultra/monitor.sh
BYPASS=/usr/share/udp2raw-ultra/bypass.sh
NFT_HELPER=/usr/share/udp2raw-ultra/nftrules.sh
ROUTE_HELPER=/usr/share/udp2raw-ultra/route.sh
LOG_DIR=/var/log/udp2raw

DNS_SERVER=""
CHECK_INTERVAL="60"
BYPASS_PROXY="1"

[ -f "$BYPASS" ] && . "$BYPASS"
[ -f "$ROUTE_HELPER" ] && . "$ROUTE_HELPER"

. /usr/share/udp2raw-ultra/resolve.sh

# Format an address for use in -l / -r (wrap IPv6 in brackets)
fmt_addr() {
	local addr="$1"
	case "$addr" in
		*:*) echo "[$addr]" ;;
		*)   echo "$addr" ;;
	esac
}

start_rule() {
	local cfg="$1"
	local enabled name mode family address port listen_addr listen_port
	local forward_addr forward_port password raw_mode cipher_mode auth_mode
	local seq_mode sock_buf auto_fw retry_on_error fix_gro log_level extra_args

	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get name "$cfg" name "$cfg"
	config_get mode "$cfg" mode "client"
	config_get family "$cfg" family "ipv4"
	config_get address "$cfg" address ""
	config_get port "$cfg" port ""
	config_get listen_addr "$cfg" listen_addr ""
	config_get listen_port "$cfg" listen_port ""
	config_get forward_addr "$cfg" forward_addr "127.0.0.1"
	config_get forward_port "$cfg" forward_port ""
	config_get password "$cfg" password ""
	config_get raw_mode "$cfg" raw_mode "faketcp"
	config_get cipher_mode "$cfg" cipher_mode "aes128cbc"
	config_get auth_mode "$cfg" auth_mode "md5"
	config_get seq_mode "$cfg" seq_mode "3"
	config_get sock_buf "$cfg" sock_buf "1024"
	config_get_bool auto_fw "$cfg" auto_fw 1
	config_get_bool retry_on_error "$cfg" retry_on_error 1
	config_get_bool fix_gro "$cfg" fix_gro 0
	config_get log_level "$cfg" log_level "4"
	config_get extra_args "$cfg" extra_args ""

	local rhost lhost
	local U2R_ROUTE_WAN_IFACE="$UDP2RAW_WAN_IFACE"

	if [ "$mode" = "server" ]; then
		# Server: listen on [::] with IPV6_V6ONLY disabled so one socket
		# accepts both IPv4 and IPv6 connections reliably on all Linux systems.
		local fwd
		fwd=$(fmt_addr "$forward_addr")

		# Ensure dual-stack (IPv4-mapped IPv6) is enabled system-wide.
		sysctl -w net.ipv6.bindv6only=0 >/dev/null 2>&1

		procd_open_instance "$name"
		procd_set_param command "$PROG" -s \
			-l "[::]:${listen_port}" \
			-r "${fwd}:${forward_port}"
	else
		# Client: resolve peer address (IP or domain), expose local UDP port
		local peer_ip="$address"
		if ! is_ip_literal "$address"; then
			peer_ip=$(resolve_addr "$address" "$family" "$DNS_SERVER")
			if [ -z "$peer_ip" ]; then
				logger -t udp2raw "rule $name: cannot resolve $address, skipping"
				return 0
			fi
		fi
		[ -z "$listen_addr" ] && listen_addr="127.0.0.1"
		rhost=$(fmt_addr "$peer_ip")
		lhost=$(fmt_addr "$listen_addr")

		# Persist the resolved IP for the web UI (keyed by rule name).
		mkdir -p /var/run/udp2raw-ultra 2>/dev/null
		echo "$peer_ip" > "/var/run/udp2raw-ultra/${name}.resolved" 2>/dev/null

		# Server exception route (opt-in): avoids tunnel deadlock when the
		# box's default route points entirely into the tunnel.
		local route_via_wan
		config_get_bool route_via_wan "$cfg" route_via_wan 0
		if [ "$route_via_wan" = "1" ] && command -v u2r_route_add >/dev/null 2>&1; then
			u2r_route_del_cfg "$cfg"
			u2r_route_add "$peer_ip" "$cfg" "$name"
		elif command -v u2r_route_del_cfg >/dev/null 2>&1; then
			u2r_route_del_cfg "$cfg"
		fi

		procd_open_instance "$name"
		procd_set_param command "$PROG" -c \
			-l "${lhost}:${listen_port}" \
			-r "${rhost}:${port}"
	fi

	[ -n "$password" ] && procd_append_param command -k "$password"
	procd_append_param command --raw-mode "$raw_mode"
	procd_append_param command --cipher-mode "$cipher_mode"
	procd_append_param command --auth-mode "$auth_mode"
	[ "$raw_mode" = "faketcp" ] && procd_append_param command --seq-mode "$seq_mode"
	procd_append_param command --sock-buf "$sock_buf"
	# Server firewall (ACCEPT inbound) + client RST drop both handled by
	# nftrules.sh via fw4 UCI -- no iptables dependency.
	[ "$retry_on_error" = "1" ] && procd_append_param command --retry-on-error
	[ "$fix_gro" = "1" ] && procd_append_param command --fix-gro
	procd_append_param command --log-level "$log_level"
	[ -n "$extra_args" ] && procd_append_param command $extra_args

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

check_monitor_rule() {
	if u2r_rule_needs_monitor "$1"; then
		MONITOR_NEEDED=1
	fi
}

start_service() {
	mkdir -p "$LOG_DIR"
	config_load udp2raw

	config_get DNS_SERVER global dns_server ""
	config_get CHECK_INTERVAL global check_interval "60"
	config_get_bool BYPASS_PROXY global bypass_proxy 1
	config_get UDP2RAW_WAN_IFACE global wan_iface ""

	MONITOR_NEEDED=0
	config_foreach check_monitor_rule rule

	# Force resolver DNS traffic out via the physical WAN, bypassing any proxy.
	if [ "$MONITOR_NEEDED" = "1" ] && [ "$BYPASS_PROXY" = "1" ] && [ -n "$DNS_SERVER" ] && command -v u2r_bypass_add >/dev/null 2>&1; then
		u2r_bypass_add "$DNS_SERVER"
	fi

	config_foreach start_rule rule

	# Apply server firewall rules via fw4 UCI (IPv4 + IPv6, no iptables needed).
	[ -x "$NFT_HELPER" ] && "$NFT_HELPER" apply

	# Fixed-IP clients, servers and disabled rules do not need a DDNS monitor.
	if [ "$MONITOR_NEEDED" = "1" ] && [ -x "$MONITOR" ]; then
		procd_open_instance "ddns-monitor"
		procd_set_param command "$MONITOR"
		procd_set_param respawn
		procd_close_instance
	fi
}

stop_service() {
	config_load udp2raw
	config_get DNS_SERVER global dns_server ""

	# Tear down the DNS bypass rules/table we created.
	if command -v u2r_bypass_flush >/dev/null 2>&1; then
		u2r_bypass_flush "$DNS_SERVER"
	fi

	# Remove server exception routes we added.
	command -v u2r_route_flush_all >/dev/null 2>&1 && u2r_route_flush_all

	# Remove server firewall rules we added.
	[ -x "$NFT_HELPER" ] && "$NFT_HELPER" flush
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "udp2raw"
}

EXTRA_COMMANDS="rule_start rule_stop rule_restart rule_resolved rule_conn rule_log"
EXTRA_HELP="	rule_start <name>    Start a single rule instance
	rule_stop <name>     Stop a single rule instance
	rule_restart <name>  Restart a single rule instance
	rule_resolved <name> Show currently resolved peer IP
	rule_conn <name>     Show handshake status (established/handshaking/none)
	rule_log <name>      Show filtered log for a rule"

rule_stop() {
	local name="$1"
	[ -n "$name" ] || { echo "usage: rule_stop <name>" >&2; return 1; }
	ubus call service delete "{\"name\":\"udp2raw\",\"instance\":\"$name\"}" 2>/dev/null

	# Drop the server-exception route for this rule (if any).
	if command -v u2r_route_del_cfg >/dev/null 2>&1; then
		config_load udp2raw
		local found_cfg=""
		_u2r_match() {
			local c="$1" nm
			config_get nm "$c" name "$c"
			[ "$nm" = "$name" ] && found_cfg="$c"
		}
		config_foreach _u2r_match rule
		[ -n "$found_cfg" ] && u2r_route_del_cfg "$found_cfg"
	fi
}

rule_start() {
	local name="$1"
	[ -n "$name" ] || { echo "usage: rule_start <name>" >&2; return 1; }
	start
}

rule_restart() {
	local name="$1"
	[ -n "$name" ] || { echo "usage: rule_restart <name>" >&2; return 1; }
	rule_stop "$name"
	sleep 1
	start
}

# ---- Per-rule diagnostics ----

# Find the UCI section id whose name field matches $1.
# Echoes: cfg|mode|listen_port|port
_u2r_rule_lookup() {
	local want="$1"
	local found="" fmode="" flp="" fp=""
	. /lib/functions.sh
	_match() {
		local c="$1" nm mode lp p
		[ -z "$found" ] || return 0
		config_get nm "$c" name "$c"
		[ "$nm" = "$want" ] || return 0
		config_get mode "$c" mode "client"
		config_get lp "$c" listen_port ""
		config_get p "$c" port ""
		found="$c"; fmode="$mode"; flp="$lp"; fp="$p"
	}
	config_load udp2raw
	config_foreach _match rule
	[ -n "$found" ] && echo "${found}|${fmode}|${flp}|${fp}"
}

rule_resolved() {
	local name="$1"
	[ -n "$name" ] || { echo ""; return 0; }
	[ -f "/var/run/udp2raw-ultra/${name}.resolved" ] && \
		cat "/var/run/udp2raw-ultra/${name}.resolved" || echo ""
}

rule_conn() {
	local name="$1"
	[ -n "$name" ] || { echo "none"; return 0; }
	local info mode lp p port lines
	info=$(_u2r_rule_lookup "$name")
	[ -n "$info" ] || { echo "none"; return 0; }
	mode=$(echo "$info" | cut -d'|' -f2)
	lp=$(echo "$info" | cut -d'|' -f3)
	p=$(echo "$info" | cut -d'|' -f4)
	# Server listens on listen_port; client connects to port.
	if [ "$mode" = "server" ]; then port="$lp"; else port="$p"; fi
	[ -n "$port" ] || { echo "none"; return 0; }
	lines=$(grep "dport=${port} " /proc/net/nf_conntrack 2>/dev/null)
	[ -n "$lines" ] || { echo "none"; return 0; }
	# Active SYN takes priority over stale ESTABLISHED entries.
	if echo "$lines" | grep -qE "SYN_SENT|SYN_RECV"; then
		echo "handshaking"
	elif echo "$lines" | grep -q "ESTABLISHED"; then
		echo "established"
	else
		echo "none"
	fi
}

rule_log() {
	local name="$1"
	[ -n "$name" ] || { echo ""; return 0; }
	local info mode tag
	info=$(_u2r_rule_lookup "$name")
	[ -n "$info" ] || { echo ""; return 0; }
	mode=$(echo "$info" | cut -d'|' -f2)
	[ "$mode" = "server" ] && tag="udp2raw" || tag="udp2raw"
	logread -e "$tag" 2>/dev/null | \
		grep -E 'FATAL|ERROR|WARN|timed out|cannot resolve|closed|listening|started' | \
		tail -100
}
