#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/udp2raw
MONITOR=/usr/share/udp2raw-ultra/monitor.sh
BYPASS=/usr/share/udp2raw-ultra/bypass.sh
LOG_DIR=/var/log/udp2raw

DNS_SERVER=""
CHECK_INTERVAL="60"
BYPASS_PROXY="1"

[ -f "$BYPASS" ] && . "$BYPASS"

# Return 0 if the argument looks like an IPv4 or IPv6 literal, 1 if it's a domain
is_ip_literal() {
	local addr="$1"
	# IPv4
	case "$addr" in
		*[!0-9.]*) ;;
		*.*.*.*) return 0 ;;
	esac
	# IPv6 (contains a colon)
	case "$addr" in
		*:*) return 0 ;;
	esac
	return 1
}

# Resolve a domain to an address according to family.
# family: auto (A first, then AAAA), ipv4 (A only), ipv6 (AAAA only)
# Tries the configured DNS first; if that yields nothing (e.g. the DNS is an
# IPv6 address but the WAN has no IPv6, or it is unreachable), it falls back
# to the system default resolver.
# echoes the resolved address or nothing
resolve_addr() {
	local domain="$1" family="$2" dns="$3"
	local ip=""

	# Primary resolver: host (from bind-host). $1 = dns (may be empty).
	_host_a()    { host -t A    "$domain" $1 2>/dev/null | awk '/has address/ {print $NF; exit}'; }
	_host_aaaa() { host -t AAAA "$domain" $1 2>/dev/null | awk '/has IPv6 address/ {print $NF; exit}'; }

	# Alternate resolver: drill (from ldns-utils). $1 = dns (may be empty).
	# Parse the answer section (non-comment lines) for the record type.
	_drill_a() {
		local s=""; [ -n "$1" ] && s="@$1"
		drill "$domain" $s A 2>/dev/null | awk '!/^;/ && $4=="A" {print $5; exit}'
	}
	_drill_aaaa() {
		local s=""; [ -n "$1" ] && s="@$1"
		drill "$domain" $s AAAA 2>/dev/null | awk '!/^;/ && $4=="AAAA" {print $5; exit}'
	}

	_resolve_a() {
		if command -v host >/dev/null 2>&1; then _host_a "$1"; else _drill_a "$1"; fi
	}
	_resolve_aaaa() {
		if command -v host >/dev/null 2>&1; then _host_aaaa "$1"; else _drill_aaaa "$1"; fi
	}

	# Try once with the given DNS server, then (if empty) with system default.
	_try() {
		local d="$1"
		case "$family" in
			ipv4) _resolve_a "$d" ;;
			ipv6) _resolve_aaaa "$d" ;;
			*)    local r=$(_resolve_a "$d"); [ -z "$r" ] && r=$(_resolve_aaaa "$d"); echo "$r" ;;
		esac
	}

	ip=$(_try "$dns")
	# Fall back to the system resolver if the configured DNS returned nothing.
	if [ -z "$ip" ] && [ -n "$dns" ]; then
		ip=$(_try "")
	fi
	echo "$ip"
}

# Format an address for use in -l / -r (wrap IPv6 in brackets)
fmt_addr() {
	local addr="$1"
	case "$addr" in
		*:*) echo "[$addr]" ;;
		*)   echo "$addr" ;;
	esac
}

start_rule() {
	local cfg="$1"
	local enabled name mode family address port listen_addr listen_port
	local forward_addr forward_port password raw_mode cipher_mode auth_mode
	local seq_mode sock_buf auto_rule retry_on_error fix_gro log_level extra_args

	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get name "$cfg" name "$cfg"
	config_get mode "$cfg" mode "client"
	config_get family "$cfg" family "auto"
	config_get address "$cfg" address ""
	config_get port "$cfg" port ""
	config_get listen_addr "$cfg" listen_addr ""
	config_get listen_port "$cfg" listen_port ""
	config_get forward_addr "$cfg" forward_addr "127.0.0.1"
	config_get forward_port "$cfg" forward_port ""
	config_get password "$cfg" password ""
	config_get raw_mode "$cfg" raw_mode "faketcp"
	config_get cipher_mode "$cfg" cipher_mode "aes128cbc"
	config_get auth_mode "$cfg" auth_mode "md5"
	config_get seq_mode "$cfg" seq_mode "3"
	config_get sock_buf "$cfg" sock_buf "1024"
	config_get_bool auto_rule "$cfg" auto_rule 1
	config_get_bool retry_on_error "$cfg" retry_on_error 1
	config_get_bool fix_gro "$cfg" fix_gro 0
	config_get log_level "$cfg" log_level "4"
	config_get extra_args "$cfg" extra_args ""

	local rhost lhost
	local logf="$LOG_DIR/${name}.log"

	if [ "$mode" = "server" ]; then
		# Server: listen on public side, forward to local UDP service
		case "$family" in
			ipv6) lhost="[::]" ;;
			*)    lhost="0.0.0.0" ;;
		esac
		local fwd=$(fmt_addr "$forward_addr")

		procd_open_instance "$name"
		procd_set_param command "$PROG" -s \
			-l "${lhost}:${listen_port}" \
			-r "${fwd}:${forward_port}"
	else
		# Client: resolve peer address (IP or domain), expose local UDP port
		local peer_ip="$address"
		if ! is_ip_literal "$address"; then
			peer_ip=$(resolve_addr "$address" "$family" "$DNS_SERVER")
			if [ -z "$peer_ip" ]; then
				logger -t udp2raw "rule $name: cannot resolve $address, skipping"
				return 0
			fi
		fi
		[ -z "$listen_addr" ] && listen_addr="127.0.0.1"
		rhost=$(fmt_addr "$peer_ip")
		lhost=$(fmt_addr "$listen_addr")

		procd_open_instance "$name"
		procd_set_param command "$PROG" -c \
			-l "${lhost}:${listen_port}" \
			-r "${rhost}:${port}"
	fi

	[ -n "$password" ] && procd_append_param command -k "$password"
	procd_append_param command --raw-mode "$raw_mode"
	procd_append_param command --cipher-mode "$cipher_mode"
	procd_append_param command --auth-mode "$auth_mode"
	[ "$raw_mode" = "faketcp" ] && procd_append_param command --seq-mode "$seq_mode"
	procd_append_param command --sock-buf "$sock_buf"
	[ "$auto_rule" = "1" ] && procd_append_param command -a
	[ "$retry_on_error" = "1" ] && procd_append_param command --retry-on-error
	[ "$fix_gro" = "1" ] && procd_append_param command --fix-gro
	procd_append_param command --log-level "$log_level"
	[ -n "$extra_args" ] && procd_append_param command $extra_args

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	mkdir -p "$LOG_DIR"
	config_load udp2raw

	config_get DNS_SERVER global dns_server ""
	config_get CHECK_INTERVAL global check_interval "60"
	config_get_bool BYPASS_PROXY global bypass_proxy 1
	config_get UDP2RAW_WAN_IFACE global wan_iface ""

	# Force resolver DNS traffic out via the physical WAN, bypassing any proxy.
	if [ "$BYPASS_PROXY" = "1" ] && [ -n "$DNS_SERVER" ] && command -v u2r_bypass_add >/dev/null 2>&1; then
		u2r_bypass_add "$DNS_SERVER"
	fi

	config_foreach start_rule rule

	# Start the DDNS monitor (only if there is at least one client with a domain)
	if [ -x "$MONITOR" ]; then
		procd_open_instance "ddns-monitor"
		procd_set_param command "$MONITOR"
		procd_set_param respawn
		procd_close_instance
	fi
}

stop_service() {
	config_load udp2raw
	config_get DNS_SERVER global dns_server ""

	# Tear down the DNS bypass rules/table we created.
	if command -v u2r_bypass_flush >/dev/null 2>&1; then
		u2r_bypass_flush "$DNS_SERVER"
	fi
}

service_triggers() {
	procd_add_reload_trigger "udp2raw"
}
