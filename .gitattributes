# Force LF line endings for all shell scripts and config files.
# OpenWrt/BusyBox ash cannot tolerate CRLF in shebang lines or rc.common.
* text=auto eol=lf

*.sh    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
Makefile text eol=lf

# init scripts and UCI configs have no extension
root/etc/init.d/*   text eol=lf
root/etc/config/*   text eol=lf

# Binary assets - never touch line endings
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.webp  binary
*.ipk   binary
